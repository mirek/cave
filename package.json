{
  "name": "cave",
  "version": "0.36.5",
  "private": true,
  "type": "module",
  "description": "CAVE — Compressed Atomic Verb Expressions. Monorepo implementing the CAVE specification (see README.md).",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirek/cave.git"
  },
  "engines": {
    "node": "^24.16.0 || ^26.1.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "bench:judge-parse": "node scripts/judge-parse-bench.mjs",
    "build": "tsc -b",
    "build:verify": "node scripts/verify-incremental-build.mjs",
    "bench:performance": "node --disable-warning=ExperimentalWarning scripts/performance-bench.mjs",
    "bench:report": "node --disable-warning=ExperimentalWarning scripts/report-bench.mjs",
    "bench:automation": "node --disable-warning=ExperimentalWarning scripts/automation-bench.mjs",
    "grammar:prepare": "node scripts/grammar-toolchain.mjs prepare",
    "grammar:verify": "node scripts/grammar-toolchain.mjs verify",
    "site:dev": "pnpm --filter @cavelang/website dev",
    "site:build": "pnpm --filter @cavelang/website build",
    "watch": "tsc -b --watch --preserveWatchOutput",
    "clean": "node scripts/clean.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm run build",
    "version-packages": "changeset version && node scripts/sync-versions.mjs && node scripts/grammar-toolchain.mjs build && pnpm install --lockfile-only --no-frozen-lockfile",
    "release:validate": "node scripts/release-validate.mjs --mode=publish",
    "release:validate:version-pr": "node scripts/release-validate.mjs --mode=version-pr",
    "release:publish": "./scripts/release-publish.sh",
    "release:audit": "node scripts/release-audit.mjs",
    "bench:pagination": "node --disable-warning=ExperimentalWarning scripts/pagination-bench.mjs",
    "bench:shape-query": "node --disable-warning=ExperimentalWarning scripts/shape-query-bench.mjs",
    "bench:rule-watermarks": "node --disable-warning=ExperimentalWarning scripts/rule-watermark-bench.mjs"
  },
  "devDependencies": {
    "@cavelang/cli": "workspace:*",
    "@changesets/cli": "3.0.2",
    "@types/node": "^22.20.2",
    "semver": "7.8.5",
    "typescript": "^5.8.0"
  }
}
