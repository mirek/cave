{
  "format": "cave.query-match-capture-review/v1",
  "method": "Sequential baseline24/current24, then baseline26/current26. Guarded loader restores the prior Query.Record.of only; store claim/provenance capture and validation plus query snapshots remain enabled. Sixteen cases per report, one warm-up, five batches of three timed calls; setup, decoder and equality assertions untimed.",
  "commands": {
    "baseline": "node --disable-warning=ExperimentalWarning --import ./benchmarks/query-match-baseline.mjs scripts/query-record-bench.mjs",
    "current": "node --disable-warning=ExperimentalWarning scripts/query-record-bench.mjs"
  },
  "limitations": [
    "One local macOS arm64 paired trial per runtime; run order and host noise can affect differences.",
    "Direct non-interpolated matches only; no large transitive-support graphs, HTTP or browser timings.",
    "Combined match capture and metadata validation cost; individual operations are not isolated."
  ],
